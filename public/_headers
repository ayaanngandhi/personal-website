# Header rules for Cloudflare Pages. Next copies public/ into out/ during
# `next build`, so this ships as out/_headers — the deploy workflow verifies it.
#
# Hashed build assets are immutable by construction: a content change produces
# a new filename, so a year-long cache is safe for anything under /_next/static.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The profile photo is not content-hashed, so it must NOT be cached long: a
# replaced photo otherwise stays invisible at the edge for hours. Revalidate
# on every request and let the ETag carry the 304s.
/profile.png
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
